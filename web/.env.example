# Skopiuj do `.env` i uzupełnij. Plik nigdy nie trafia do repozytorium ani obrazu.
# Wygeneruj SECRET_KEY_BASE:  docker compose run --rm --no-deps web bundle exec rails secret
# (albo lokalnie:  openssl rand -hex 64 )

POSTGRES_USER=stacja
POSTGRES_PASSWORD=ZMIEN_NA_SILNE_HASLO
POSTGRES_DB=stacja_production

SECRET_KEY_BASE=ZMIEN_NA_DLUGI_LOSOWY_CIAG

# Token autoryzujący ESP przy wysyłce pomiarów (POST /api/measurements).
# Ten sam token ustaw w firmware ESP (include/config.h: INGEST_TOKEN).
INGEST_TOKEN=ZMIEN_NA_DLUGI_LOSOWY_TOKEN

# Domena(y) dozwolona w config.hosts (oddzielone przecinkiem).
APP_HOSTS=stacjaprudnik.online,www.stacjaprudnik.online

# Adresy proxy, którym ufamy przy odczycie realnego IP klienta (X-Forwarded-For).
# Domyślnie podsieć Docker compose (172.28.0.0/16) + pętla lokalna.
TRUSTED_PROXIES=172.28.0.0/16,127.0.0.1,::1

# E-mail dla Let's Encrypt (używany przez skrypt certbot/init-letsencrypt.sh).
LETSENCRYPT_EMAIL=admin@stacjaprudnik.online